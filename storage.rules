rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/items/{itemId}/{fileName} {
      allow read, write: if request.auth != null
                          && request.resource.size < 8 * 1024 * 1024
                          && request.resource.contentType.matches('image/.*');
    }
  }
}
