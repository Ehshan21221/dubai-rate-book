rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in users can read/write. Since this reuses your existing
    // Firebase project, this won't affect Shop Ops Hub / Inventory PWA rules —
    // just add these rules for the "companies" and "settings" collections
    // alongside whatever you already have.
    match /companies/{companyId} {
      allow read, write: if request.auth != null;
      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }
    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
